# The repo declares engines.node ">=22.0.0" in package.json, and the tooling
# genuinely needs it: jsdom 30 pulls undici 8.12, which reads
# zlib.ZstdDecompress at import time, and that symbol does not exist before
# Node 22. Without this line npm only warns, so an install on Node 20
# succeeds and the first symptom shows up later as a stack trace from inside
# node_modules. With it, `npm install` and `npm ci` refuse on the spot.
#
# `node tools/preflight.mjs` is the second half of the same rule: it catches
# a clone that was installed correctly and then switched Node version.
engine-strict=true
