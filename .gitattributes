# Generated release artifact — do not edit, excluded from language stats.
# -text: build.mjs writes this file with explicit CRLF line endings.
# Without -text, core.autocrlf normalizes CRLF -> LF on `git add`, so the
# committed blob silently stops byte-matching what the build script
# actually produced - every subsequent `npm run build` then shows a
# spurious "modified" diff that is pure line-ending churn. -text stores
# exactly the bytes on disk, no conversion either direction.
ProcureSherpa-v2.0.html linguist-generated=true -diff -text
_check.js linguist-generated=true -diff -text

# Shell scripts must keep LF endings regardless of the checking-out
# platform's core.autocrlf - a CRLF shebang line is unreliable to
# execute even under Git Bash on Windows. This matters for
# .githooks/pre-push specifically, which git executes directly.
.githooks/* text eol=lf
*.sh text eol=lf
